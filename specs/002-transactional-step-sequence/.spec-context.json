  "decisions": [
    {
      "decision": "Events are recorded with a static DomainEvents.record(event) bound to the unit of work; fails fast outside one",
      "why": "No base class or interface on aggregates; works for event-sourced and state-stored aggregates",
      "rejected": "RecordsDomainEvents interface + base class; apply/raise/publish naming"
    },
    {
      "decision": "Aggregate persistence stays in client code: @AggregateLoader/@AggregateSaver methods, else host AggregateResolver (Spring Data adapter in the starter), else client unit of work",
      "why": "Client code never implements a Saga Forge interface",
      "rejected": "Client-implemented AggregateRepository SPI"
    },
    {
      "decision": "One @AggregateIdentifier for aggregates, commands and events; @DomainEvent(aggregate = X.class) required",
      "why": "Each completed step records the aggregates it touched, for the compensation spec",
      "rejected": "Separate @TargetAggregateIdentifier; inferring the aggregate type"
    }
  ],
