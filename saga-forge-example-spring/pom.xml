<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gkosharovdev</groupId>
        <artifactId>saga-forge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>saga-forge-example-spring</artifactId>
    <name>Saga Forge Example - Spring Boot</name>
    <description>The canonical order saga as a Spring Boot application assembled by the starter</description>

    <!-- Versions pinned to the Spring Boot 4.1.2 line without importing its BOM (G-DEP-01), as in the starter. -->
    <properties>
        <spring-boot.version>4.1.2</spring-boot.version>
        <spring-framework.version>7.0.10</spring-framework.version>
        <spring-data.version>2026.0.2</spring-data.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <saga.excludedTestGroups>container</saga.excludedTestGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.data</groupId>
                <artifactId>spring-data-bom</artifactId>
                <version>${spring-data.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>tools.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>3.1.7</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-spring-boot-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-storage-postgres</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
            <version>${spring-boot.version}</version>
        </dependency>

        <!-- Test dependencies -->
        <!-- Fixture tests of the saga with the application's own beans, no database (009 US5, SC-006) -->
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-test</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- As Spring Boot's parent does: Spring Data maps constructor parameters by name. -->
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludedGroups>${saga.excludedTestGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Runs the Testcontainers-backed classes tagged "container" (needs a container runtime) -->
        <profile>
            <id>container-tests</id>
            <properties>
                <saga.excludedTestGroups></saga.excludedTestGroups>
            </properties>
        </profile>
    </profiles>
</project>
