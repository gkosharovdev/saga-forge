<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.gkosharovdev</groupId>
        <artifactId>saga-forge</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>saga-forge-example</artifactId>
    <name>Saga Forge Example</name>
    <description>Example saga demonstrating the Saga Forge annotation model</description>

    <dependencies>
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Runs the example on the engine in tests only; main sources stay engine-free (SC-009) -->
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-engine</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Engine test doubles: InMemoryTransactionBoundary, TransactionalInMemoryStorageProvider, TestTransport -->
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-engine</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <!-- Core test doubles: InMemorySagaContextStore, MapHandlerInstanceProvider -->
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-core</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- Test dependencies for integration tests -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
            <!-- 007: the canonical saga over the in-memory transport (SC-004) -->
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-transport-inmemory</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.gkosharovdev</groupId>
            <artifactId>saga-forge-transport-inmemory</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
