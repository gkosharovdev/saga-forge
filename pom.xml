<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.gkosharovdev</groupId>
    <artifactId>saga-forge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Saga Forge</name>
    <description>A declarative Java framework for orchestrating long-running, multi-step business processes (sagas)</description>
    <url>https://github.com/gkosharovdev/saga-forge</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>gkosharovdev</id>
            <name>Georgi Kosharov</name>
            <url>https://github.com/gkosharovdev</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/gkosharovdev/saga-forge.git</connection>
        <developerConnection>scm:git:git@github.com:gkosharovdev/saga-forge.git</developerConnection>
        <url>https://github.com/gkosharovdev/saga-forge</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/gkosharovdev/saga-forge/issues</url>
    </issueManagement>

    <modules>
        <module>saga-forge-core</module>
        <module>saga-forge-runtime</module>
        <module>saga-forge-test</module>
        <module>saga-forge-storage-postgres</module>
        <module>saga-forge-storage-mongodb</module>
        <module>saga-forge-storage-mysql</module>
        <module>saga-forge-transport-inmemory</module>
        <module>saga-forge-transport-kafka</module>
        <module>saga-forge-spring-boot-starter</module>
        <module>saga-forge-example</module>
        <module>saga-forge-example-spring</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <jqwik.version>1.9.2</jqwik.version>
        <assertj.version>3.27.3</assertj.version>
        <!-- The version Spring Boot 4.1.x manages, so applications get one API version (010 research §10) -->
        <opentelemetry.version>1.62.0</opentelemetry.version>
        <!-- Release profile: whether a validated deployment is published without a manual step in the portal -->
        <central.autoPublish>false</central.autoPublish>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-bom</artifactId>
                <version>${opentelemetry.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>net.jqwik</groupId>
                <artifactId>jqwik</artifactId>
                <version>${jqwik.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <!--
          Builds what Maven Central requires and publishes through the Sonatype Central Portal (see README "Releasing"):
          sources and Javadoc jars, GPG signatures, one deployment bundle. The examples and the placeholder modules are
          left out of the bundle. Credentials come from the "central" server in settings.xml; the release workflow writes
          it from the CENTRAL_TOKEN_* secrets.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <configuration>
                            <!-- Missing comments on obvious accessors are not release blockers; broken HTML and references are. -->
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; loopback lets gpg read it non-interactively. -->
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.8.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- false: the deployment waits in the portal for a manual "Publish"; true publishes once validated. -->
                            <autoPublish>${central.autoPublish}</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <excludeArtifacts>
                                <artifact>saga-forge-example</artifact>
                                <artifact>saga-forge-example-spring</artifact>
                                <artifact>saga-forge-storage-mysql</artifact>
                                <artifact>saga-forge-storage-mongodb</artifact>
                                <artifact>saga-forge-transport-kafka</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
